{
  "name": "100x-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript front end for 100xPortfolio (bundled to static/app.js).",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --format=iife --outfile=static/app.js",
    "watch": "esbuild src/main.ts --bundle --sourcemap --format=iife --outfile=static/app.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
